# Copy to .dev.vars for `wrangler dev` if you intentionally enable live stubs.
# .dev.vars is gitignored. Leave every secret blank to stay on mocks.
# This portfolio demo never ships tokens, and the HTTP API rejects
# any email that is not @example.com and any domain that is not *.example.

ADAPTERS=mock
ICP_THRESHOLD=70
DEMO_PACE_MS=220

# HUBSPOT_TOKEN=
# SLACK_WEBHOOK_URL=
# CLEARBIT_KEY=
# APOLLO_API_KEY=
# PDL_API_KEY=
