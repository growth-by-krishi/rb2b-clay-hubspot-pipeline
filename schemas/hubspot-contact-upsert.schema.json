{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example/hubspot-contact-upsert.schema.json",
  "title": "HubSpot CRM v3 contact batch upsert",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputs"],
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "idProperty", "properties"],
        "properties": {
          "id": { "type": "string", "format": "email" },
          "idProperty": { "const": "email" },
          "properties": {
            "type": "object",
            "required": ["email", "firstname", "lastname", "jobtitle", "company", "lifecyclestage", "hs_lead_status", "icp_score", "icp_disposition"],
            "properties": {
              "email": { "type": "string", "format": "email" },
              "firstname": { "type": "string" },
              "lastname": { "type": "string" },
              "jobtitle": { "type": "string" },
              "company": { "type": "string" },
              "website": { "type": "string" },
              "industry": { "type": "string" },
              "lifecyclestage": { "enum": ["marketingqualifiedlead", "lead"] },
              "hs_lead_status": { "enum": ["OPEN", "NEW"] },
              "icp_score": { "type": "string" },
              "icp_disposition": { "enum": ["mql", "nurture"] }
            }
          }
        }
      }
    }
  }
}
