{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example/normalized-visitor.schema.json",
  "title": "Normalized visitor",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "firstName", "lastName", "fullName", "email", "title", "company", "domain", "pages", "seenAt"],
  "properties": {
    "source": { "const": "rb2b" },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "fullName": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "title": { "type": "string" },
    "company": { "type": "string" },
    "domain": { "type": "string" },
    "industry": { "type": ["string", "null"] },
    "employeeCount": { "type": ["number", "null"] },
    "employeeRange": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "linkedinUrl": { "type": ["string", "null"] },
    "seenAt": { "type": "string" },
    "referrer": { "type": ["string", "null"] },
    "capturedUrl": { "type": ["string", "null"] },
    "pages": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
