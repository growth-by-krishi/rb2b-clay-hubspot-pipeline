{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example/slack-alert.schema.json",
  "title": "Slack incoming webhook payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "blocks"],
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
